{
  "server": {
    "port": 9443,
    "certificates": {
      "cert_path": "./conf/cert.pem",
      "key_path": "./conf/key.pem",
      "ca_path": "./conf/trustroot.pem"
    },
    "performance": {
      "buffer_size": 65536,
      "tcp_keep_alive": 30,
      "read_buffer_size": 0,
      "write_buffer_size": 0,
      "max_concurrent_conns": 1000,
      "enable_compression": true,
      "no_delay": true
    }
  },
  "proxy": {
    "default_site": "https://www.lapo.it"
  },
  "stats": {
    "enabled": true,
    "file_path": "./stats/user_stats.json",
    "db_path": "./stats/proxy_stats.db",
    "save_period_seconds": 30,
    "flush_interval_seconds": 30,
    "retention": {
      "minute_stats_days": 7,
      "hourly_stats_days": 90,
      "daily_stats_days": 90
    }
  },
  "admin": {
    "enabled": true,
    "port": 9444,
    "language": "en",
    "interfaces": {
      "web": true,
      "api": true
    }
  }
} 